<Window x:Class="NeptunoWPF.Views.ProveedorEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proveedor"
        Height="829"
        Width="850"
        MinHeight="650"
        MinWidth="750"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F5F7FA">

    <Window.Resources>

        <!-- ========================================= -->
        <!-- ESTILO DE ETIQUETAS -->
        <!-- ========================================= -->

        <Style x:Key="LabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#243B5A"/>

            <Setter Property="Margin"
                    Value="0,0,0,7"/>

        </Style>


        <!-- ========================================= -->
        <!-- ESTILO DE TEXTBOX -->
        <!-- ========================================= -->

        <Style x:Key="InputStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="12,8"/>

            <Setter Property="Margin"
                    Value="0,0,0,20"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="BorderBrush"
                    Value="#CCD6E2"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Background"
                    Value="White"/>

        </Style>


        <!-- ========================================= -->
        <!-- BOTÓN GUARDAR -->
        <!-- ========================================= -->

        <Style x:Key="GuardarButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="130"/>

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#2563EB"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>


        <!-- ========================================= -->
        <!-- BOTÓN CANCELAR -->
        <!-- ========================================= -->

        <Style x:Key="CancelarButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="130"/>

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#243B5A"/>

            <Setter Property="Background"
                    Value="#E5E7EB"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

    </Window.Resources>


    <!-- ============================================= -->
    <!-- CONTENEDOR PRINCIPAL -->
    <!-- ============================================= -->

    <Grid Margin="28">

        <Grid.RowDefinitions>

            <!-- Encabezado -->
            <RowDefinition Height="Auto"/>

            <!-- Formulario -->
            <RowDefinition Height="*"/>

            <!-- Botones -->
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- ============================================= -->
        <!-- ENCABEZADO -->
        <!-- ============================================= -->

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#DCE5F0"
                BorderThickness="1"
                CornerRadius="14"
                Padding="25"
                Margin="0,0,0,20">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="70"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- ICONO -->

                <Border Grid.Column="0"
                        Width="58"
                        Height="58"
                        CornerRadius="12"
                        Background="#2563EB"
                        HorizontalAlignment="Left">

                    <TextBlock Text="▤"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>


                <!-- TÍTULOS -->

                <StackPanel Grid.Column="1"
                            Margin="18,0,0,0"
                            VerticalAlignment="Center">

                    <!-- NUEVO -->

                    <TextBlock Text="Nuevo proveedor"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#1E3555">

                        <TextBlock.Style>

                            <Style TargetType="TextBlock">

                                <Setter Property="Visibility"
                                        Value="Visible"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding EsEdicion}"
                                                 Value="True">

                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </TextBlock.Style>

                    </TextBlock>


                    <!-- EDITAR -->

                    <TextBlock Text="Editar proveedor"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#1E3555">

                        <TextBlock.Style>

                            <Style TargetType="TextBlock">

                                <Setter Property="Visibility"
                                        Value="Collapsed"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding EsEdicion}"
                                                 Value="True">

                                        <Setter Property="Visibility"
                                                Value="Visible"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </TextBlock.Style>

                    </TextBlock>


                    <TextBlock Text="Ingrese los datos del proveedor"
                               FontSize="14"
                               Foreground="#718096"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ============================================= -->
        <!-- FORMULARIO -->
        <!-- ============================================= -->

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#DCE5F0"
                BorderThickness="1"
                CornerRadius="14"
                Padding="25">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- ===================================== -->
                    <!-- COLUMNA IZQUIERDA -->
                    <!-- ===================================== -->

                    <StackPanel Grid.Column="0"
                                Margin="0,0,15,0">


                        <!-- Compañía -->

                        <TextBlock Text="Compañía"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding Proveedor.CompaniaNombre,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="60"
                                 Style="{StaticResource InputStyle}"/>


                        <!-- Nombre contacto -->

                        <TextBlock Text="Nombre de contacto"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding Proveedor.NombreContacto,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="40"
                                 Style="{StaticResource InputStyle}"/>


                        <!-- Cargo -->

                        <TextBlock Text="Cargo del contacto"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding Proveedor.CargoContacto,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="40"
                                 Style="{StaticResource InputStyle}"/>


                        <!-- Dirección -->

                        <TextBlock Text="Dirección"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding Proveedor.Direccion,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="80"
                                 Style="{StaticResource InputStyle}"/>


                        <!-- Ciudad -->

                        <TextBlock Text="Ciudad"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding Proveedor.Ciudad,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="30"
                                 Style="{StaticResource InputStyle}"/>

                    </StackPanel>


                    <!-- ===================================== -->
                    <!-- COLUMNA DERECHA -->
                    <!-- ===================================== -->

                    <StackPanel Grid.Column="1"
                                Margin="15,0,0,0">


                        <!-- Código postal -->

                        <TextBlock Text="Código postal"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding Proveedor.CodigoPostal,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="10"
                                 Style="{StaticResource InputStyle}"/>


                        <!-- País -->

                        <TextBlock Text="País"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding Proveedor.Pais,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="30"
                                 Style="{StaticResource InputStyle}"/>


                        <!-- Teléfono -->

                        <TextBlock Text="Teléfono"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding Proveedor.Telefono,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="24"
                                 Style="{StaticResource InputStyle}"/>


                        <!-- Fax -->

                        <TextBlock Text="Fax"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding Proveedor.Fax,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="24"
                                 Style="{StaticResource InputStyle}"/>


                        <!-- Información -->

                        <Border Background="#F1F5F9"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,10">

                            <TextBlock Text="Los campos de contacto, dirección y comunicación son opcionales."
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="#64748B"/>

                        </Border>

                    </StackPanel>

                </Grid>

            </ScrollViewer>

        </Border>


        <!-- ============================================= -->
        <!-- BOTONES -->
        <!-- ============================================= -->

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#DCE5F0"
                BorderThickness="1"
                CornerRadius="14"
                Padding="20"
                Margin="0,20,0,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Cancelar"
                        Style="{StaticResource CancelarButtonStyle}"
                        Click="Cancelar_Click"
                        Margin="0,0,12,0"/>

                <Button Content="Guardar"
                        Style="{StaticResource GuardarButtonStyle}"
                        Click="Guardar_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>