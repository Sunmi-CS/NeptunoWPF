<Window x:Class="NeptunoWPF.Views.ProveedorEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proveedor"
        Height="650"
        Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FA">

    <Window.Resources>

        <!-- Estilo para TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#263238"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,6,0,18"/>
        </Style>

        <!-- Estilo para Button -->
        <Style TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Border Margin="20"
                Background="White"
                CornerRadius="12"
                Padding="25">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Título -->
                <TextBlock Grid.Row="0"
                           Text="Editar proveedor"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#263238"
                           Margin="0,0,0,22"/>

                <!-- Compañía -->
                <TextBlock Grid.Row="1"
                           Text="Compañía"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#455A64"/>

                <TextBox Grid.Row="2"
                         Text="{Binding Proveedor.CompaniaNombre,
                                UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Nombre de contacto -->
                <TextBlock Grid.Row="3"
                           Text="Nombre de contacto"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#455A64"/>

                <TextBox Grid.Row="4"
                         Text="{Binding Proveedor.NombreContacto,
                                UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Cargo -->
                <TextBlock Grid.Row="5"
                           Text="Cargo"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#455A64"/>

                <TextBox Grid.Row="6"
                         Text="{Binding Proveedor.CargoContacto,
                                UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Dirección -->
                <TextBlock Grid.Row="7"
                           Text="Dirección"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#455A64"/>

                <TextBox Grid.Row="8"
                         Text="{Binding Proveedor.Direccion,
                                UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Ciudad -->
                <TextBlock Grid.Row="9"
                           Text="Ciudad"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#455A64"/>

                <TextBox Grid.Row="10"
                         Text="{Binding Proveedor.Ciudad,
                                UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Botones -->
                <StackPanel Grid.Row="11"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0">

                    <Button Content="Guardar"
                            Margin="0,0,10,0"
                            Background="#1976D2"
                            Click="Guardar_Click"/>

                    <Button Content="Cancelar"
                            Background="#78909C"
                            Click="Cancelar_Click"/>

                </StackPanel>

            </Grid>

        </Border>

    </ScrollViewer>

</Window>
