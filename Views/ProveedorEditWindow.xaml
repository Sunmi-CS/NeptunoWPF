<Window x:Class="NeptunoWPF.Views.ProveedorEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proveedor"
        Height="650"
        Width="550"
        WindowStartupLocation="CenterOwner">

    <ScrollViewer>

        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Compañía"/>

            <TextBox Grid.Row="1"
                     Margin="0,5,0,10"
                     Text="{Binding Proveedor.CompaniaNombre,
                            UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="2"
                       Text="Nombre de contacto"/>

            <TextBox Grid.Row="3"
                     Margin="0,5,0,10"
                     Text="{Binding Proveedor.NombreContacto,
                            UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="4"
                       Text="Cargo"/>

            <TextBox Grid.Row="5"
                     Margin="0,5,0,10"
                     Text="{Binding Proveedor.CargoContacto,
                            UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="6"
                       Text="Dirección"/>

            <TextBox Grid.Row="7"
                     Margin="0,5,0,10"
                     Text="{Binding Proveedor.Direccion,
                            UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="8"
                       Text="Ciudad"/>

            <TextBox Grid.Row="9"
                     Margin="0,5,0,10"
                     Text="{Binding Proveedor.Ciudad,
                            UpdateSourceTrigger=PropertyChanged}"/>

            <StackPanel Grid.Row="10"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,0,0,297">

                <Button Content="Guardar"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="Guardar_Click" Height="26"/>

                <Button Content="Cancelar"
                        Width="100"
                        Click="Cancelar_Click" Height="26"/>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</Window>