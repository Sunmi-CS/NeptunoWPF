<Window x:Class="NeptunoWPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NeptunoDB - Sistema de Gestión"
        Height="750"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">

    <Window.Resources>

        <!-- =========================
             COLORES Y ESTILOS
             ========================= -->

        <!-- Botón principal -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón secundario -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#64748B"/>
        </Style>

        <!-- Botón eliminar -->
        <Style x:Key="DeleteButtonStyle" TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#DC2626"/>
        </Style>

        <!-- Botón buscar -->
        <Style x:Key="SearchButtonStyle" TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#0F766E"/>
        </Style>

        <!-- Botón reporte -->
        <Style x:Key="ReportButtonStyle" TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#7C3AED"/>
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E2E8F0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <!-- Encabezado DataGrid -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Filas DataGrid -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TabControl -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- TabItem -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Padding" Value="25,12"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

        <!-- DatePicker -->
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- TextBlock para títulos -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- Etiquetas -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>


    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- =========================
             ENCABEZADO
             ========================= -->

        <Border Grid.Row="0"
                Background="#1E293B"
                CornerRadius="12"
                Padding="25,18"
                Margin="0,0,0,15">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="NeptunoDB"
                               Foreground="White"
                               FontSize="25"
                               FontWeight="Bold"/>

                    <TextBlock Text="Sistema de Gestión"
                               Foreground="#CBD5E1"
                               FontSize="13"
                               Margin="0,3,0,0"/>

                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="GESTIÓN DE DATOS"
                           Foreground="#93C5FD"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

            </Grid>

        </Border>


        <!-- =========================
             CONTENIDO
             ========================= -->

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="15"
                BorderBrush="#E2E8F0"
                BorderThickness="1">

            <TabControl>


                <!-- =========================
                     PRODUCTOS
                     ========================= -->

                <TabItem Header="Productos">

                    <Grid Margin="15">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <StackPanel Grid.Row="0">

                            <TextBlock Text="Gestión de productos"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,15">

                                <Button Content="Nuevo"
                                        Width="100"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="NuevoProducto_Click"/>

                                <Button Content="Editar"
                                        Width="100"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="EditarProducto_Click"/>

                                <Button Content="Eliminar"
                                        Width="100"
                                        Style="{StaticResource DeleteButtonStyle}"
                                        Click="EliminarProducto_Click"/>

                                <Button Content="Actualizar"
                                        Width="110"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="ActualizarProductos_Click"/>

                            </StackPanel>

                        </StackPanel>


                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Productos.Productos}"
                                  SelectedItem="{Binding Productos.ProductoSeleccionado}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">

                            <DataGrid.Columns>

                                <!-- ID -->
                                <DataGridTextColumn
        Header="ID"
        Binding="{Binding ProductoID}"
        Width="60"/>

                                <!-- Nombre -->
                                <DataGridTextColumn
        Header="Producto"
        Binding="{Binding NombreProducto}"
        Width="190"/>

                                <!-- Proveedor -->
                                <DataGridTextColumn
        Header="Proveedor"
        Binding="{Binding Proveedor}"
        Width="180"/>

                                <!-- Categoría -->
                                <DataGridTextColumn
        Header="Categoría"
        Binding="{Binding Categoria}"
        Width="150"/>

                                <!-- Cantidad por unidad -->
                                <DataGridTextColumn
        Header="Cantidad por unidad"
        Binding="{Binding CantidadPorUnidad}"
        Width="150"/>

                                <!-- Precio -->
                                <DataGridTextColumn
        Header="Precio"
        Binding="{Binding PrecioUnidad, StringFormat={}{0:F2}}"
        Width="90"/>

                                <!-- Unidades en existencia -->
                                <DataGridTextColumn
        Header="Existencia"
        Binding="{Binding UnidadesEnExistencia}"
        Width="100"/>

                                <!-- Unidades en pedido -->
                                <DataGridTextColumn
        Header="En pedido"
        Binding="{Binding UnidadesEnPedido}"
        Width="90"/>

                                <!-- Nivel de reorden -->
                                <DataGridTextColumn
        Header="Nivel de reorden"
        Binding="{Binding NivelDeReorden}"
        Width="110"/>

                                <!-- Descontinuado -->
                                <DataGridCheckBoxColumn
        Header="Descontinuado"
        Binding="{Binding Descontinuado}"
        Width="110"/>

                            </DataGrid.Columns>
                        </DataGrid>

                    </Grid>

                </TabItem>


                <!-- =========================
                     CATEGORÍAS
                     ========================= -->

                <TabItem Header="Categorías">

                    <Grid Margin="15">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <StackPanel Grid.Row="0">

                            <TextBlock Text="Gestión de categorías"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,15">

                                <Button Content="Nuevo"
                                        Width="100"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="NuevoCategoria_Click"/>

                                <Button Content="Editar"
                                        Width="100"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="EditarCategoria_Click"/>

                                <Button Content="Eliminar"
                                        Width="100"
                                        Style="{StaticResource DeleteButtonStyle}"
                                        Click="EliminarCategoria_Click"/>

                                <Button Content="Actualizar"
                                        Width="110"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="ActualizarCategorias_Click"/>

                            </StackPanel>

                        </StackPanel>


                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Categorias.Categorias}"
                                  SelectedItem="{Binding Categorias.CategoriaSeleccionada}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">

                            <DataGrid.Columns>

                                <DataGridTextColumn
                                    Header="ID"
                                    Binding="{Binding CategoriaID}"
                                    Width="70"/>

                                <DataGridTextColumn
                                    Header="Nombre"
                                    Binding="{Binding NombreCategoria}"
                                    Width="250"/>

                                <DataGridTextColumn
                                    Header="Descripción"
                                    Binding="{Binding Descripcion}"
                                    Width="*"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </TabItem>


                <!-- =========================
                     PROVEEDORES
                     ========================= -->

                <TabItem Header="Proveedores">

                    <Grid Margin="15">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <!-- TÍTULO -->

                        <TextBlock Grid.Row="0"
                                   Text="Gestión de proveedores"
                                   Style="{StaticResource SectionTitleStyle}"/>


                        <!-- BUSCADOR -->

                        <Border Grid.Row="1"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,0,15">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="Contacto:"
                                           Style="{StaticResource LabelStyle}"
                                           Margin="0,0,7,0"/>

                                <TextBox Width="180"
                                         Margin="0,0,20,0"
                                         Text="{Binding Proveedores.NombreContactoFiltro,
                                                UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Ciudad:"
                                           Style="{StaticResource LabelStyle}"
                                           Margin="0,0,7,0"/>

                                <TextBox Width="150"
                                         Margin="0,0,20,0"
                                         Text="{Binding Proveedores.CiudadFiltro,
                                                UpdateSourceTrigger=PropertyChanged}"/>

                                <Button Content="Buscar"
                                        Width="100"
                                        Style="{StaticResource SearchButtonStyle}"
                                        Click="BuscarProveedor_Click"/>

                                <Button Content="Limpiar"
                                        Width="100"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="LimpiarProveedor_Click"/>

                            </StackPanel>

                        </Border>


                        <!-- BOTONES -->

                        <StackPanel Grid.Row="2"
                                    Orientation="Vertical">

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,10">

                                <Button Content="Nuevo"
                                        Width="100"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="NuevoProveedor_Click"/>

                                <Button Content="Editar"
                                        Width="100"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="EditarProveedor_Click"/>

                                <Button Content="Eliminar"
                                        Width="100"
                                        Style="{StaticResource DeleteButtonStyle}"
                                        Click="EliminarProveedor_Click"/>

                            </StackPanel>


                            <DataGrid
                                    ItemsSource="{Binding Proveedores.Proveedores}"
                                    SelectedItem="{Binding Proveedores.ProveedorSeleccionado}"
                                    AutoGenerateColumns="False"
                                    IsReadOnly="True"
                                    HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollBarVisibility="Auto">

                                <DataGrid.Columns>

                                    <!-- ID -->
                                    <DataGridTextColumn
        Header="ID"
        Binding="{Binding ProveedorID}"
        Width="60"/>

                                    <!-- Compañía -->
                                    <DataGridTextColumn
        Header="Compañía"
        Binding="{Binding CompaniaNombre}"
        Width="190"/>

                                    <!-- Nombre contacto -->
                                    <DataGridTextColumn
        Header="Contacto"
        Binding="{Binding NombreContacto}"
        Width="160"/>

                                    <!-- Cargo -->
                                    <DataGridTextColumn
        Header="Cargo"
        Binding="{Binding CargoContacto}"
        Width="150"/>

                                    <!-- Dirección -->
                                    <DataGridTextColumn
        Header="Dirección"
        Binding="{Binding Direccion}"
        Width="180"/>

                                    <!-- Ciudad -->
                                    <DataGridTextColumn
        Header="Ciudad"
        Binding="{Binding Ciudad}"
        Width="120"/>

                                    <!-- Código postal -->
                                    <DataGridTextColumn
        Header="Código postal"
        Binding="{Binding CodigoPostal}"
        Width="100"/>

                                    <!-- País -->
                                    <DataGridTextColumn
        Header="País"
        Binding="{Binding Pais}"
        Width="100"/>

                                    <!-- Teléfono -->
                                    <DataGridTextColumn
        Header="Teléfono"
        Binding="{Binding Telefono}"
        Width="130"/>

                                    <!-- Fax -->
                                    <DataGridTextColumn
        Header="Fax"
        Binding="{Binding Fax}"
        Width="130"/>

                                </DataGrid.Columns>
                            </DataGrid>

                        </StackPanel>

                    </Grid>

                </TabItem>


                <!-- =========================
                     PEDIDOS
                     ========================= -->

                <TabItem Header="Pedidos">

                    <Grid Margin="15">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <!-- TÍTULO + BOTONES -->

                        <StackPanel Grid.Row="0">

                            <TextBlock Text="Gestión de pedidos"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,15">

                                <Button Content="Nuevo"
                                        Width="100"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="NuevoPedido_Click"/>

                                <Button Content="Editar"
                                        Width="100"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="EditarPedido_Click"/>

                                <Button Content="Eliminar"
                                        Width="100"
                                        Style="{StaticResource DeleteButtonStyle}"
                                        Click="EliminarPedido_Click"/>

                                <Button Content="Actualizar"
                                        Width="110"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="ActualizarPedidos_Click"/>

                            </StackPanel>

                        </StackPanel>


                        <!-- LISTADO PEDIDOS -->

                        <DataGrid Grid.Row="1"
          ItemsSource="{Binding Pedidos.Pedidos}"
          SelectedItem="{Binding Pedidos.PedidoSeleccionado}"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          HorizontalScrollBarVisibility="Auto"
          VerticalScrollBarVisibility="Auto">

                            <DataGrid.Columns>

                                <!-- ID DEL PEDIDO -->
                                <DataGridTextColumn
            Header="ID"
            Binding="{Binding PedidoID}"
            Width="70"/>

                                <!-- CLIENTE ID -->
                                <DataGridTextColumn
            Header="Cliente ID"
            Binding="{Binding ClienteID}"
            Width="80"/>

                                <!-- CLIENTE -->
                                <DataGridTextColumn
            Header="Cliente"
            Binding="{Binding Cliente}"
            Width="180"/>

                                <!-- EMPLEADO ID -->
                                <DataGridTextColumn
            Header="Empleado ID"
            Binding="{Binding EmpleadoID}"
            Width="90"/>

                                <!-- EMPLEADO -->
                                <DataGridTextColumn
            Header="Empleado"
            Binding="{Binding Empleado}"
            Width="160"/>

                                <!-- FECHA PEDIDO -->
                                <DataGridTextColumn
            Header="Fecha pedido"
            Binding="{Binding FechaPedido, StringFormat={}{0:dd/MM/yyyy}}"
            Width="110"/>

                                <!-- FECHA REQUERIDA -->
                                <DataGridTextColumn
            Header="Fecha requerida"
            Binding="{Binding FechaRequerida, StringFormat={}{0:dd/MM/yyyy}}"
            Width="120"/>

                                <!-- FECHA ENVÍO -->
                                <DataGridTextColumn
            Header="Fecha envío"
            Binding="{Binding FechaEnvio, StringFormat={}{0:dd/MM/yyyy}}"
            Width="110"/>

                                <!-- TRANSPORTISTA ID -->
                                <DataGridTextColumn
            Header="Transportista ID"
            Binding="{Binding TransportistaID}"
            Width="110"/>

                                <!-- TRANSPORTISTA -->
                                <DataGridTextColumn
            Header="Transportista"
            Binding="{Binding Transportista}"
            Width="180"/>

                                <!-- DESTINATARIO -->
                                <DataGridTextColumn
            Header="Destinatario"
            Binding="{Binding Destinatario}"
            Width="180"/>

                                <!-- CIUDAD DESTINO -->
                                <DataGridTextColumn
            Header="Ciudad destino"
            Binding="{Binding CiudadDestino}"
            Width="140"/>

                                <!-- PAÍS DESTINO -->
                                <DataGridTextColumn
            Header="País destino"
            Binding="{Binding PaisDestino}"
            Width="120"/>

                            </DataGrid.Columns>

                        </DataGrid>


                        <!-- FILTRO REPORTE -->

                        <Border Grid.Row="2"
        Background="#F8FAFC"
        BorderBrush="#E2E8F0"
        BorderThickness="1"
        CornerRadius="8"
        Padding="15"
        Margin="0,15,0,10">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="Reporte por fechas"
                   FontSize="14"
                   FontWeight="Bold"
                   Foreground="#334155"
                   VerticalAlignment="Center"
                   Margin="0,0,25,0"/>

                                <TextBlock Text="Desde:"
                   Style="{StaticResource LabelStyle}"
                   VerticalAlignment="Center"
                   Margin="0,0,7,0"/>

                                <DatePicker SelectedDate="{Binding Pedidos.FechaInicio, Mode=TwoWay}"
                    Width="130"
                    Margin="0,0,20,0"/>

                                <TextBlock Text="Hasta:"
                   Style="{StaticResource LabelStyle}"
                   VerticalAlignment="Center"
                   Margin="0,0,7,0"/>

                                <DatePicker SelectedDate="{Binding Pedidos.FechaFin, Mode=TwoWay}"
                    Width="130"
                    Margin="0,0,20,0"/>

                                <Button Content="Generar reporte"
                Width="135"
                Style="{StaticResource ReportButtonStyle}"
                Click="GenerarReporte_Click"/>

                            </StackPanel>

                        </Border>



                        <!-- REPORTE -->

                        <!-- REPORTE DETALLADO -->

                        <Border Grid.Row="3"
        Background="White"
        BorderBrush="#E2E8F0"
        BorderThickness="1"
        CornerRadius="8"
        Padding="5">

                            <DataGrid ItemsSource="{Binding Pedidos.ReporteDetalles}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Auto">

                                <DataGrid.Columns>

                                    <!-- PEDIDO -->
                                    <DataGridTextColumn Header="Pedido"
                                Binding="{Binding PedidoID}"
                                Width="80"/>

                                    <!-- FECHA -->
                                    <DataGridTextColumn Header="Fecha"
                                Binding="{Binding FechaPedido, StringFormat={}{0:dd/MM/yyyy}}"
                                Width="110"/>

                                    <!-- PRODUCTO -->
                                    <DataGridTextColumn Header="Producto"
                                Binding="{Binding NombreProducto}"
                                Width="250"/>

                                    <!-- PRECIO -->
                                    <DataGridTextColumn Header="Precio"
                                Binding="{Binding PrecioUnidad, StringFormat={}{0:F2}}"
                                Width="100"/>

                                    <!-- CANTIDAD -->
                                    <DataGridTextColumn Header="Cantidad"
                                Binding="{Binding Cantidad}"
                                Width="90"/>

                                    <!-- DESCUENTO -->
                                    <DataGridTextColumn Header="Descuento"
                                Binding="{Binding Descuento, StringFormat={}{0:F2}}"
                                Width="100"/>

                                    <!-- SUBTOTAL -->
                                    <DataGridTextColumn Header="Subtotal"
                                Binding="{Binding Subtotal, StringFormat={}{0:F2}}"
                                Width="120"/>

                                </DataGrid.Columns>

                            </DataGrid>

                        </Border>
                    </Grid>

                </TabItem>

            </TabControl>

        </Border>

    </Grid>

</Window>