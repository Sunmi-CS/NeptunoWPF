<Window x:Class="NeptunoWPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NeptunoDB - Sistema de Gestión"
        Height="750"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">

    <Window.Resources>

        <!-- =========================
             COLORES Y ESTILOS
             ========================= -->

        <!-- Botón principal -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón secundario -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#64748B"/>
        </Style>

        <!-- Botón eliminar -->
        <Style x:Key="DeleteButtonStyle" TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#DC2626"/>
        </Style>

        <!-- Botón buscar -->
        <Style x:Key="SearchButtonStyle" TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#0F766E"/>
        </Style>

        <!-- Botón reporte -->
        <Style x:Key="ReportButtonStyle" TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#7C3AED"/>
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E2E8F0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <!-- Encabezado DataGrid -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Filas DataGrid -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TabControl -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- TabItem -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Padding" Value="25,12"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

        <!-- DatePicker -->
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- TextBlock para títulos -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- Etiquetas -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>


    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- =========================
             ENCABEZADO
             ========================= -->

        <Border Grid.Row="0"
                Background="#1E293B"
                CornerRadius="12"
                Padding="25,18"
                Margin="0,0,0,15">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="NeptunoDB"
                               Foreground="White"
                               FontSize="25"
                               FontWeight="Bold"/>

                    <TextBlock Text="Sistema de Gestión"
                               Foreground="#CBD5E1"
                               FontSize="13"
                               Margin="0,3,0,0"/>

                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="GESTIÓN DE DATOS"
                           Foreground="#93C5FD"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

            </Grid>

        </Border>


        <!-- =========================
             CONTENIDO
             ========================= -->

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="15"
                BorderBrush="#E2E8F0"
                BorderThickness="1">

            <TabControl>


                <!-- =========================
                     PRODUCTOS
                     ========================= -->

                <TabItem Header="Productos">

                    <Grid Margin="15">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <StackPanel Grid.Row="0">

                            <TextBlock Text="Gestión de productos"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,15">

                                <Button Content="Nuevo"
                                        Width="100"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="NuevoProducto_Click"/>

                                <Button Content="Editar"
                                        Width="100"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="EditarProducto_Click"/>

                                <Button Content="Eliminar"
                                        Width="100"
                                        Style="{StaticResource DeleteButtonStyle}"
                                        Click="EliminarProducto_Click"/>

                                <Button Content="Actualizar"
                                        Width="110"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="ActualizarProductos_Click"/>

                            </StackPanel>

                        </StackPanel>


                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Productos.Productos}"
                                  SelectedItem="{Binding Productos.ProductoSeleccionado}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">

                            <DataGrid.Columns>

                                <DataGridTextColumn
                                    Header="ID"
                                    Binding="{Binding ProductoID}"
                                    Width="60"/>

                                <DataGridTextColumn
                                    Header="Producto"
                                    Binding="{Binding NombreProducto}"
                                    Width="220"/>

                                <DataGridTextColumn
                                    Header="Proveedor"
                                    Binding="{Binding Proveedor}"
                                    Width="180"/>

                                <DataGridTextColumn
                                    Header="Categoría"
                                    Binding="{Binding Categoria}"
                                    Width="150"/>

                                <DataGridTextColumn
                                    Header="Precio"
                                    Binding="{Binding PrecioUnidad}"
                                    Width="100"/>

                                <DataGridTextColumn
                                    Header="Stock"
                                    Binding="{Binding UnidadesEnExistencia}"
                                    Width="80"/>

                                <DataGridCheckBoxColumn
                                    Header="Descontinuado"
                                    Binding="{Binding Descontinuado}"
                                    Width="110"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </TabItem>


                <!-- =========================
                     CATEGORÍAS
                     ========================= -->

                <TabItem Header="Categorías">

                    <Grid Margin="15">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <StackPanel Grid.Row="0">

                            <TextBlock Text="Gestión de categorías"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,15">

                                <Button Content="Nuevo"
                                        Width="100"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="NuevoCategoria_Click"/>

                                <Button Content="Editar"
                                        Width="100"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="EditarCategoria_Click"/>

                                <Button Content="Eliminar"
                                        Width="100"
                                        Style="{StaticResource DeleteButtonStyle}"
                                        Click="EliminarCategoria_Click"/>

                                <Button Content="Actualizar"
                                        Width="110"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="ActualizarCategorias_Click"/>

                            </StackPanel>

                        </StackPanel>


                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Categorias.Categorias}"
                                  SelectedItem="{Binding Categorias.CategoriaSeleccionada}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">

                            <DataGrid.Columns>

                                <DataGridTextColumn
                                    Header="ID"
                                    Binding="{Binding CategoriaID}"
                                    Width="70"/>

                                <DataGridTextColumn
                                    Header="Nombre"
                                    Binding="{Binding NombreCategoria}"
                                    Width="250"/>

                                <DataGridTextColumn
                                    Header="Descripción"
                                    Binding="{Binding Descripcion}"
                                    Width="*"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </TabItem>


                <!-- =========================
                     PROVEEDORES
                     ========================= -->

                <TabItem Header="Proveedores">

                    <Grid Margin="15">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <!-- TÍTULO -->

                        <TextBlock Grid.Row="0"
                                   Text="Gestión de proveedores"
                                   Style="{StaticResource SectionTitleStyle}"/>


                        <!-- BUSCADOR -->

                        <Border Grid.Row="1"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,0,15">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="Contacto:"
                                           Style="{StaticResource LabelStyle}"
                                           Margin="0,0,7,0"/>

                                <TextBox Width="180"
                                         Margin="0,0,20,0"
                                         Text="{Binding Proveedores.NombreContactoFiltro,
                                                UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Ciudad:"
                                           Style="{StaticResource LabelStyle}"
                                           Margin="0,0,7,0"/>

                                <TextBox Width="150"
                                         Margin="0,0,20,0"
                                         Text="{Binding Proveedores.CiudadFiltro,
                                                UpdateSourceTrigger=PropertyChanged}"/>

                                <Button Content="Buscar"
                                        Width="100"
                                        Style="{StaticResource SearchButtonStyle}"
                                        Click="BuscarProveedor_Click"/>

                                <Button Content="Limpiar"
                                        Width="100"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="LimpiarProveedor_Click"/>

                            </StackPanel>

                        </Border>


                        <!-- BOTONES -->

                        <StackPanel Grid.Row="2"
                                    Orientation="Vertical">

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,10">

                                <Button Content="Nuevo"
                                        Width="100"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="NuevoProveedor_Click"/>

                                <Button Content="Editar"
                                        Width="100"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="EditarProveedor_Click"/>

                                <Button Content="Eliminar"
                                        Width="100"
                                        Style="{StaticResource DeleteButtonStyle}"
                                        Click="EliminarProveedor_Click"/>

                            </StackPanel>


                            <DataGrid
                                ItemsSource="{Binding Proveedores.Proveedores}"
                                SelectedItem="{Binding Proveedores.ProveedorSeleccionado}"
                                AutoGenerateColumns="False"
                                IsReadOnly="True">

                                <DataGrid.Columns>

                                    <DataGridTextColumn
                                        Header="ID"
                                        Binding="{Binding ProveedorID}"
                                        Width="60"/>

                                    <DataGridTextColumn
                                        Header="Compañía"
                                        Binding="{Binding CompaniaNombre}"
                                        Width="200"/>

                                    <DataGridTextColumn
                                        Header="Contacto"
                                        Binding="{Binding NombreContacto}"
                                        Width="180"/>

                                    <DataGridTextColumn
                                        Header="Ciudad"
                                        Binding="{Binding Ciudad}"
                                        Width="130"/>

                                    <DataGridTextColumn
                                        Header="País"
                                        Binding="{Binding Pais}"
                                        Width="100"/>

                                    <DataGridTextColumn
                                        Header="Teléfono"
                                        Binding="{Binding Telefono}"
                                        Width="150"/>

                                </DataGrid.Columns>

                            </DataGrid>

                        </StackPanel>

                    </Grid>

                </TabItem>


                <!-- =========================
                     PEDIDOS
                     ========================= -->

                <TabItem Header="Pedidos">

                    <Grid Margin="15">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <!-- TÍTULO + BOTONES -->

                        <StackPanel Grid.Row="0">

                            <TextBlock Text="Gestión de pedidos"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,15">

                                <Button Content="Nuevo"
                                        Width="100"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="NuevoPedido_Click"/>

                                <Button Content="Editar"
                                        Width="100"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="EditarPedido_Click"/>

                                <Button Content="Eliminar"
                                        Width="100"
                                        Style="{StaticResource DeleteButtonStyle}"
                                        Click="EliminarPedido_Click"/>

                                <Button Content="Actualizar"
                                        Width="110"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="ActualizarPedidos_Click"/>

                            </StackPanel>

                        </StackPanel>


                        <!-- LISTADO PEDIDOS -->

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Pedidos.Pedidos}"
                                  SelectedItem="{Binding Pedidos.PedidoSeleccionado}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">

                            <DataGrid.Columns>

                                <DataGridTextColumn
                                    Header="ID"
                                    Binding="{Binding PedidoID}"
                                    Width="60"/>

                                <DataGridTextColumn
                                    Header="Cliente"
                                    Binding="{Binding Cliente}"
                                    Width="200"/>

                                <DataGridTextColumn
                                    Header="Empleado"
                                    Binding="{Binding Empleado}"
                                    Width="180"/>

                                <DataGridTextColumn
                                    Header="Fecha pedido"
                                    Binding="{Binding FechaPedido, StringFormat=d}"
                                    Width="120"/>

                                <DataGridTextColumn
                                    Header="Fecha requerida"
                                    Binding="{Binding FechaRequerida, StringFormat=d}"
                                    Width="120"/>

                                <DataGridTextColumn
                                    Header="Transportista"
                                    Binding="{Binding Transportista}"
                                    Width="180"/>

                                <DataGridTextColumn
                                    Header="Ciudad"
                                    Binding="{Binding CiudadDestino}"
                                    Width="120"/>

                            </DataGrid.Columns>

                        </DataGrid>


                        <!-- FILTRO REPORTE -->

                        <Border Grid.Row="2"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,15,0,10">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="Reporte por fechas"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#334155"
                                           VerticalAlignment="Center"
                                           Margin="0,0,25,0"/>

                                <TextBlock Text="Desde:"
                                           Style="{StaticResource LabelStyle}"
                                           Margin="0,0,7,0"/>

                                <DatePicker SelectedDate="{Binding Pedidos.FechaInicio}"
                                            Width="130"
                                            Margin="0,0,20,0"/>

                                <TextBlock Text="Hasta:"
                                           Style="{StaticResource LabelStyle}"
                                           Margin="0,0,7,0"/>

                                <DatePicker SelectedDate="{Binding Pedidos.FechaFin}"
                                            Width="130"
                                            Margin="0,0,20,0"/>

                                <Button Content="Generar reporte"
                                        Width="135"
                                        Style="{StaticResource ReportButtonStyle}"
                                        Click="GenerarReporte_Click"/>

                            </StackPanel>

                        </Border>


                        <!-- REPORTE -->

                        <DataGrid Grid.Row="3"
                                  ItemsSource="{Binding Pedidos.ReporteDetalles}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">

                            <DataGrid.Columns>

                                <DataGridTextColumn
                                    Header="Pedido"
                                    Binding="{Binding PedidoID}"
                                    Width="70"/>

                                <DataGridTextColumn
                                    Header="Fecha"
                                    Binding="{Binding FechaPedido, StringFormat=d}"
                                    Width="100"/>

                                <DataGridTextColumn
                                    Header="Producto"
                                    Binding="{Binding NombreProducto}"
                                    Width="250"/>

                                <DataGridTextColumn
                                    Header="Precio"
                                    Binding="{Binding PrecioUnidad}"
                                    Width="100"/>

                                <DataGridTextColumn
                                    Header="Cantidad"
                                    Binding="{Binding Cantidad}"
                                    Width="90"/>

                                <DataGridTextColumn
                                    Header="Descuento"
                                    Binding="{Binding Descuento}"
                                    Width="100"/>

                                <DataGridTextColumn
                                    Header="Subtotal"
                                    Binding="{Binding Subtotal}"
                                    Width="120"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </TabItem>

            </TabControl>

        </Border>

    </Grid>

</Window>