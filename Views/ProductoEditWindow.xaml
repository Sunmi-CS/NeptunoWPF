<Window x:Class="NeptunoWPF.Views.ProductoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Producto"
        Height="720"
        Width="850"
        MinHeight="650"
        MinWidth="750"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F5F7FA">

    <Window.Resources>

        <!-- Estilo general para etiquetas -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#243B5A"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <!-- Estilo para TextBox -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CCD6E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- Estilo para ComboBox -->
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CCD6E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- Botón Guardar -->
        <Style x:Key="GuardarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Botón Cancelar -->
        <Style x:Key="CancelarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#243B5A"/>
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>


    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- ENCABEZADO -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#DCE5F0"
                BorderThickness="1"
                CornerRadius="14"
                Padding="25"
                Margin="0,0,0,22">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Icono -->
                <Border Grid.Column="0"
                        Width="58"
                        Height="58"
                        CornerRadius="12"
                        Background="#2563EB"
                        HorizontalAlignment="Left">

                    <TextBlock Text="▣"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Título -->
                <StackPanel Grid.Column="1"
                            Margin="18,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="TituloFormulario"
                               Text="Nuevo producto"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#1E3555"/>

                    <TextBlock Text="Ingrese los datos del producto"
                               FontSize="14"
                               Foreground="#718096"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- FORMULARIO -->
        <!-- ===================================================== -->

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#DCE5F0"
                BorderThickness="1"
                CornerRadius="14"
                Padding="25">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Grid>

                    <!-- Dos columnas -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- ================================================= -->
                    <!-- COLUMNA IZQUIERDA -->
                    <!-- ================================================= -->

                    <StackPanel Grid.Column="0"
                                Margin="0,0,15,0">

                        <!-- Nombre -->
                        <TextBlock Text="Nombre del producto"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding Producto.NombreProducto,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="60"
                                 Style="{StaticResource InputStyle}"/>


                        <!-- Proveedor -->
                        <TextBlock Text="Proveedor"
                                   Style="{StaticResource LabelStyle}"/>

                        <ComboBox ItemsSource="{Binding Proveedores}"
                                  DisplayMemberPath="CompaniaNombre"
                                  SelectedValuePath="ProveedorID"
                                  SelectedValue="{Binding Producto.ProveedorID,
                                                          Mode=TwoWay,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource ComboStyle}"/>


                        <!-- Cantidad por unidad -->
                        <TextBlock Text="Cantidad por unidad"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding Producto.CantidadPorUnidad,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="30"
                                 Style="{StaticResource InputStyle}"/>


                        <!-- Precio -->
                        <TextBlock Text="Precio por unidad"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding Producto.PrecioUnidad,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>


                        <!-- Unidades en existencia -->
                        <TextBlock Text="Unidades en existencia"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding Producto.UnidadesEnExistencia,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- COLUMNA DERECHA -->
                    <!-- ================================================= -->

                    <StackPanel Grid.Column="1"
                                Margin="15,0,0,0">

                        <!-- Categoría -->
                        <TextBlock Text="Categoría"
                                   Style="{StaticResource LabelStyle}"/>

                        <ComboBox ItemsSource="{Binding Categorias}"
                                  DisplayMemberPath="NombreCategoria"
                                  SelectedValuePath="CategoriaID"
                                  SelectedValue="{Binding Producto.CategoriaID,
                                                          Mode=TwoWay,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource ComboStyle}"/>


                        <!-- Unidades en pedido -->
                        <TextBlock Text="Unidades en pedido"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding Producto.UnidadesEnPedido,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>


                        <!-- Nivel de reorden -->
                        <TextBlock Text="Nivel de reorden"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding Producto.NivelDeReorden,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>


                        <!-- Estado -->
                        <TextBlock Text="Estado del producto"
                                   Style="{StaticResource LabelStyle}"/>

                        <Border Height="42"
                                Background="#F8FAFC"
                                BorderBrush="#CCD6E2"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12,0"
                                Margin="0,0,0,20">

                            <CheckBox Content="Producto descontinuado"
                                      IsChecked="{Binding Producto.Descontinuado,
                                                          Mode=TwoWay,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center"
                                      FontSize="14"
                                      Foreground="#243B5A"/>

                        </Border>


                        <!-- Información -->
                        <Border Background="#F1F5F9"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,10">

                            <TextBlock Text="Los campos numéricos deben contener valores válidos. El ID del producto se genera automáticamente."
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="#64748B"/>

                        </Border>

                    </StackPanel>

                </Grid>

            </ScrollViewer>

        </Border>


        <!-- ===================================================== -->
        <!-- BOTONES -->
        <!-- ===================================================== -->

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#DCE5F0"
                BorderThickness="1"
                CornerRadius="14"
                Padding="20"
                Margin="0,20,0,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Cancelar"
                        Style="{StaticResource CancelarButtonStyle}"
                        Click="Cancelar_Click"
                        Margin="0,0,12,0"/>

                <Button Content="Guardar"
                        Style="{StaticResource GuardarButtonStyle}"
                        Click="Guardar_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>