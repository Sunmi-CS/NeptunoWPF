<Window x:Class="NeptunoWPF.Views.ProductoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Producto"
        Height="760"
        Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FA">

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- ENCABEZADO -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                Background="White"
                CornerRadius="12"
                Padding="22"
                Margin="0,0,0,20"
                BorderBrush="#E1E6ED"
                BorderThickness="1">

            <StackPanel>

                <TextBlock x:Name="TituloFormulario"
                           Text="Nuevo producto"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#1F365C"/>

                <TextBlock Text="Ingrese los datos del producto"
                           FontSize="14"
                           Foreground="#718096"
                           Margin="0,6,0,0"/>

            </StackPanel>

        </Border>


        <!-- ===================================================== -->
        <!-- FORMULARIO -->
        <!-- ===================================================== -->

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="28"
                BorderBrush="#E1E6ED"
                BorderThickness="1">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Grid>

                    <!-- Dos columnas -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- ================================================= -->
                    <!-- FILA 1 - ID / NOMBRE -->
                    <!-- ================================================= -->

                    <StackPanel Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,15,18">

                        <TextBlock Text="ID del producto"
                                   FontWeight="SemiBold"
                                   Foreground="#243B64"
                                   Margin="0,0,0,6"/>

                        <TextBox Text="{Binding Producto.ProductoID}"
                                 IsReadOnly="True"
                                 Background="#F1F3F6"
                                 Foreground="#667085"
                                 BorderBrush="#D0D5DD"
                                 Height="42"
                                 Padding="10"
                                 FontSize="14"/>

                    </StackPanel>


                    <StackPanel Grid.Row="0"
                                Grid.Column="1"
                                Margin="15,0,0,18">

                        <TextBlock Text="Nombre del producto"
                                   FontWeight="SemiBold"
                                   Foreground="#243B64"
                                   Margin="0,0,0,6"/>

                        <TextBox Text="{Binding Producto.NombreProducto,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="60"
                                 Height="42"
                                 Padding="10"
                                 FontSize="14"/>

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- FILA 2 - PROVEEDOR / CATEGORÍA -->
                    <!-- ================================================= -->

                    <StackPanel Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,0,15,18">

                        <TextBlock Text="Proveedor"
                                   FontWeight="SemiBold"
                                   Foreground="#243B64"
                                   Margin="0,0,0,6"/>

                        <ComboBox ItemsSource="{Binding Proveedores}"
                                  DisplayMemberPath="CompaniaNombre"
                                  SelectedValuePath="ProveedorID"
                                  SelectedValue="{Binding Producto.ProveedorID,
                                                          Mode=TwoWay,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                  Height="42"
                                  FontSize="14"/>

                    </StackPanel>


                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Margin="15,0,0,18">

                        <TextBlock Text="Categoría"
                                   FontWeight="SemiBold"
                                   Foreground="#243B64"
                                   Margin="0,0,0,6"/>

                        <ComboBox ItemsSource="{Binding Categorias}"
                                  DisplayMemberPath="NombreCategoria"
                                  SelectedValuePath="CategoriaID"
                                  SelectedValue="{Binding Producto.CategoriaID,
                                                          Mode=TwoWay,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                  Height="42"
                                  FontSize="14"/>

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- FILA 3 - CANTIDAD / PRECIO -->
                    <!-- ================================================= -->

                    <StackPanel Grid.Row="2"
                                Grid.Column="0"
                                Margin="0,0,15,18">

                        <TextBlock Text="Cantidad por unidad"
                                   FontWeight="SemiBold"
                                   Foreground="#243B64"
                                   Margin="0,0,0,6"/>

                        <TextBox Text="{Binding Producto.CantidadPorUnidad,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="30"
                                 Height="42"
                                 Padding="10"
                                 FontSize="14"/>

                    </StackPanel>


                    <StackPanel Grid.Row="2"
                                Grid.Column="1"
                                Margin="15,0,0,18">

                        <TextBlock Text="Precio por unidad"
                                   FontWeight="SemiBold"
                                   Foreground="#243B64"
                                   Margin="0,0,0,6"/>

                        <TextBox Text="{Binding Producto.PrecioUnidad,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Height="42"
                                 Padding="10"
                                 FontSize="14"/>

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- FILA 4 - EXISTENCIA / PEDIDO -->
                    <!-- ================================================= -->

                    <StackPanel Grid.Row="3"
                                Grid.Column="0"
                                Margin="0,0,15,18">

                        <TextBlock Text="Unidades en existencia"
                                   FontWeight="SemiBold"
                                   Foreground="#243B64"
                                   Margin="0,0,0,6"/>

                        <TextBox Text="{Binding Producto.UnidadesEnExistencia,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Height="42"
                                 Padding="10"
                                 FontSize="14"/>

                    </StackPanel>


                    <StackPanel Grid.Row="3"
                                Grid.Column="1"
                                Margin="15,0,0,18">

                        <TextBlock Text="Unidades en pedido"
                                   FontWeight="SemiBold"
                                   Foreground="#243B64"
                                   Margin="0,0,0,6"/>

                        <TextBox Text="{Binding Producto.UnidadesEnPedido,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Height="42"
                                 Padding="10"
                                 FontSize="14"/>

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- FILA 5 - REORDEN / DESCONTINUADO -->
                    <!-- ================================================= -->

                    <StackPanel Grid.Row="4"
                                Grid.Column="0"
                                Margin="0,0,15,18">

                        <TextBlock Text="Nivel de reorden"
                                   FontWeight="SemiBold"
                                   Foreground="#243B64"
                                   Margin="0,0,0,6"/>

                        <TextBox Text="{Binding Producto.NivelDeReorden,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Height="42"
                                 Padding="10"
                                 FontSize="14"/>

                    </StackPanel>


                    <StackPanel Grid.Row="4"
                                Grid.Column="1"
                                Margin="15,0,0,18">

                        <TextBlock Text="Estado del producto"
                                   FontWeight="SemiBold"
                                   Foreground="#243B64"
                                   Margin="0,0,0,12"/>

                        <CheckBox Content="Producto descontinuado"
                                  IsChecked="{Binding Producto.Descontinuado,
                                                      Mode=TwoWay,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                  FontSize="14"
                                  VerticalAlignment="Center"/>

                    </StackPanel>

                </Grid>

            </ScrollViewer>

        </Border>


        <!-- ===================================================== -->
        <!-- BOTONES -->
        <!-- ===================================================== -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="20"
                Margin="0,20,0,0"
                BorderBrush="#E1E6ED"
                BorderThickness="1">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Cancelar"
                        Width="120"
                        Height="42"
                        Margin="0,0,12,0"
                        Background="#E5E7EB"
                        Foreground="#243B64"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        FontSize="14"
                        Click="Cancelar_Click"/>

                <Button Content="Guardar"
                        Width="140"
                        Height="42"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        FontSize="14"
                        Click="Guardar_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>