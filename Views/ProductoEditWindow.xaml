<Window x:Class="NeptunoWPF.Views.ProductoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Producto"
        Height="500"
        Width="500"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Nombre del producto"/>
        <TextBox Grid.Row="1"
                 Margin="0,5,0,10"
                 Text="{Binding Producto.NombreProducto,
                        UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="2"
                   Text="Cantidad por unidad"/>

        <TextBox Grid.Row="3"
                 Margin="0,5,0,10"
                 Text="{Binding Producto.CantidadPorUnidad,
                        UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="4"
                   Text="Precio"/>

        <TextBox Grid.Row="5"
                 Margin="0,5,0,10"
                 Text="{Binding Producto.PrecioUnidad,
                        UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="6"
                   Text="Unidades en existencia"/>

        <TextBox Grid.Row="7"
                 Margin="0,5,0,10"
                 Text="{Binding Producto.UnidadesEnExistencia,
                        UpdateSourceTrigger=PropertyChanged}"/>

        <CheckBox Grid.Row="8"
                  Content="Descontinuado"
                  IsChecked="{Binding Producto.Descontinuado}"
                  Margin="0,5,0,10"/>

        <StackPanel Grid.Row="9"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">

            <Button Content="Guardar"
                    Width="100"
                    Margin="0,0,10,0"
                    Click="Guardar_Click"/>

            <Button Content="Cancelar"
                    Width="100"
                    Click="Cancelar_Click"/>

        </StackPanel>

    </Grid>

</Window>