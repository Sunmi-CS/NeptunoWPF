<Window x:Class="NeptunoWPF.Views.ProductoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo Producto"
        Height="654"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FA">

    <Window.Resources>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Etiquetas -->
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>

        <!-- Guardar -->
        <Style x:Key="GuardarButton"
               TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Cancelar -->
        <Style x:Key="CancelarButton"
               TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </Window.Resources>

    <Border Margin="18"
            Background="White"
            CornerRadius="12"
            BorderBrush="#E5E7EB"
            BorderThickness="1">

        <Grid Margin="25">

            <!-- AHORA SÍ SON 14 FILAS: 0 HASTA 13 -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- ENCABEZADO -->
            <StackPanel Grid.Row="0"
                        Margin="0,0,0,20">

                <TextBlock x:Name="TituloFormulario"
                           Text="Nuevo Producto"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#111827"/>

                <TextBlock Text="Ingrese los datos del producto"
                           Margin="0,4,0,0"
                           FontSize="12"
                           FontWeight="Normal"
                           Foreground="#6B7280"/>

            </StackPanel>


            <!-- ID -->
            <TextBlock Grid.Row="1"
                       Text="ID del producto"/>

            <TextBox Grid.Row="2"
                     Margin="0,5,0,12"
                     Text="{Binding Producto.ProductoID}"
                     IsReadOnly="True"
                     Background="#F3F4F6"
                     Foreground="#6B7280"/>


            <!-- PRODUCTO -->
            <TextBlock Grid.Row="3"
                       Text="Nombre del producto"/>

            <TextBox Grid.Row="4"
                     Margin="0,5,0,12"
                     Text="{Binding Producto.NombreProducto,
                            UpdateSourceTrigger=PropertyChanged}"/>


            <!-- PROVEEDOR -->
            <TextBlock Grid.Row="5"
                       Text="Proveedor"/>

            <ComboBox Grid.Row="6"
                      Margin="0,5,0,12"
                      ItemsSource="{Binding Proveedores}"
                      DisplayMemberPath="CompaniaNombre"
                      SelectedValuePath="ProveedorID"
                      SelectedValue="{Binding Producto.ProveedorID,
                                               Mode=TwoWay,
                                               UpdateSourceTrigger=PropertyChanged}"/>


            <!-- CATEGORÍA -->
            <TextBlock Grid.Row="7"
                       Text="Categoría"/>

            <ComboBox Grid.Row="8"
                      Margin="0,5,0,12"
                      ItemsSource="{Binding Categorias}"
                      DisplayMemberPath="NombreCategoria"
                      SelectedValuePath="CategoriaID"
                      SelectedValue="{Binding Producto.CategoriaID,
                                               Mode=TwoWay,
                                               UpdateSourceTrigger=PropertyChanged}"/>


            <!-- PRECIO -->
            <TextBlock Grid.Row="9"
                       Text="Precio"/>

            <TextBox Grid.Row="10"
                     Margin="0,5,0,12"
                     Text="{Binding Producto.PrecioUnidad,
                            UpdateSourceTrigger=PropertyChanged,
                            StringFormat={}{0:F2}}"/>


            <!-- STOCK -->
            <TextBlock Grid.Row="11"
                       Text="Stock"/>

            <TextBox Grid.Row="12"
                     Margin="0,5,0,20"
                     Text="{Binding Producto.UnidadesEnExistencia,
                            UpdateSourceTrigger=PropertyChanged}"/>


            <!-- BOTONES -->
            <StackPanel Grid.Row="13"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,5,0,0">

                <Button Content="Guardar"
                        Style="{StaticResource GuardarButton}"
                        Margin="0,0,10,0"
                        Click="Guardar_Click"/>

                <Button Content="Cancelar"
                        Style="{StaticResource CancelarButton}"
                        Click="Cancelar_Click"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>
