<Window x:Class="NeptunoWPF.Views.PedidoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pedido"
        Height="650"
        Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FA">

    <Window.Resources>

        <!-- Estilo para ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#263238"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,6,0,18"/>
        </Style>

        <!-- Estilo para DatePicker -->
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#263238"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,6,0,18"/>
        </Style>

        <!-- Estilo general para botones -->
        <Style TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

    </Window.Resources>

    <Border Margin="20"
            Background="White"
            CornerRadius="12"
            Padding="25">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Título -->
            <TextBlock Grid.Row="0"
                       Text="Editar pedido"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#263238"
                       Margin="0,0,0,22"/>

            <!-- Cliente -->
            <TextBlock Grid.Row="1"
                       Text="Cliente"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#455A64"/>

            <ComboBox Grid.Row="2"
                      ItemsSource="{Binding Clientes}"
                      DisplayMemberPath="Empresa"
                      SelectedValuePath="ClienteID"
                      SelectedValue="{Binding Pedido.ClienteID}"/>

            <!-- Empleado -->
            <TextBlock Grid.Row="3"
                       Text="Empleado"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#455A64"/>

            <ComboBox Grid.Row="4"
                      ItemsSource="{Binding Empleados}"
                      DisplayMemberPath="NombreCompleto"
                      SelectedValuePath="EmpleadoID"
                      SelectedValue="{Binding Pedido.EmpleadoID}"/>

            <!-- Fecha pedido -->
            <TextBlock Grid.Row="5"
                       Text="Fecha pedido"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#455A64"/>

            <DatePicker Grid.Row="6"
                        SelectedDate="{Binding Pedido.FechaPedido}"/>

            <!-- Fecha requerida -->
            <TextBlock Grid.Row="7"
                       Text="Fecha requerida"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#455A64"/>

            <DatePicker Grid.Row="8"
                        SelectedDate="{Binding Pedido.FechaRequerida}"/>

            <!-- Transportista -->
            <TextBlock Grid.Row="9"
                       Text="Transportista"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#455A64"/>

            <ComboBox Grid.Row="10"
                      ItemsSource="{Binding Transportistas}"
                      DisplayMemberPath="CompaniaNombre"
                      SelectedValuePath="TransportistaID"
                      SelectedValue="{Binding Pedido.TransportistaID}"/>

            <!-- Botones -->
            <StackPanel Grid.Row="11"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">

                <Button Content="Guardar"
                        Margin="0,0,10,0"
                        Background="#1976D2"
                        Click="Guardar_Click"/>

                <Button Content="Cancelar"
                        Background="#78909C"
                        Click="Cancelar_Click"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>
