<Window x:Class="NeptunoWPF.Views.PedidoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pedido"
        Height="550"
        Width="550"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Cliente"/>

        <ComboBox Grid.Row="1"
                  Margin="0,5,0,10"
                  ItemsSource="{Binding Clientes}"
                  DisplayMemberPath="Empresa"
                  SelectedValuePath="ClienteID"
                  SelectedValue="{Binding Pedido.ClienteID}"/>

        <TextBlock Grid.Row="2"
                   Text="Empleado"/>

        <ComboBox Grid.Row="3"
                  Margin="0,5,0,10"
                  ItemsSource="{Binding Empleados}"
                  DisplayMemberPath="NombreCompleto"
                  SelectedValuePath="EmpleadoID"
                  SelectedValue="{Binding Pedido.EmpleadoID}"/>

        <TextBlock Grid.Row="4"
                   Text="Fecha pedido"/>

        <DatePicker Grid.Row="5"
                    Margin="0,5,0,10"
                    SelectedDate="{Binding Pedido.FechaPedido}"/>

        <TextBlock Grid.Row="6"
                   Text="Fecha requerida"/>

        <DatePicker Grid.Row="7"
                    Margin="0,5,0,10"
                    SelectedDate="{Binding Pedido.FechaRequerida}"/>

        <TextBlock Grid.Row="8"
                   Text="Transportista"/>

        <ComboBox Grid.Row="9"
                  Margin="0,5,0,10"
                  ItemsSource="{Binding Transportistas}"
                  DisplayMemberPath="CompaniaNombre"
                  SelectedValuePath="TransportistaID"
                  SelectedValue="{Binding Pedido.TransportistaID}"/>

        <StackPanel Grid.Row="9"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">

            <Button Content="Guardar"
                    Width="100"
                    Margin="0,0,10,0"
                    Click="Guardar_Click"/>

            <Button Content="Cancelar"
                    Width="100"
                    Click="Cancelar_Click"/>

        </StackPanel>

    </Grid>

</Window>