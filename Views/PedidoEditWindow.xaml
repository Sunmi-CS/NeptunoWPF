<Window x:Class="NeptunoWPF.Views.PedidoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pedido"
        Height="811"
        Width="900"
        MinHeight="700"
        MinWidth="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F5F7FA">

    <Window.Resources>

        <!-- ========================================= -->
        <!-- ESTILO DE ETIQUETAS -->
        <!-- ========================================= -->

        <Style x:Key="LabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#243B5A"/>

            <Setter Property="Margin"
                    Value="0,0,0,7"/>

        </Style>


        <!-- ========================================= -->
        <!-- TEXTBOX -->
        <!-- ========================================= -->

        <Style x:Key="InputStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="12,8"/>

            <Setter Property="Margin"
                    Value="0,0,0,20"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="BorderBrush"
                    Value="#CCD6E2"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Background"
                    Value="White"/>

        </Style>


        <!-- ========================================= -->
        <!-- COMBOBOX -->
        <!-- ========================================= -->

        <Style x:Key="ComboStyle"
               TargetType="ComboBox">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="10,5"/>

            <Setter Property="Margin"
                    Value="0,0,0,20"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="BorderBrush"
                    Value="#CCD6E2"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Background"
                    Value="White"/>

        </Style>


        <!-- ========================================= -->
        <!-- DATEPICKER -->
        <!-- ========================================= -->

        <Style x:Key="DateStyle"
               TargetType="DatePicker">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Margin"
                    Value="0,0,0,20"/>

            <Setter Property="BorderBrush"
                    Value="#CCD6E2"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Background"
                    Value="White"/>

        </Style>


        <!-- ========================================= -->
        <!-- BOTÓN GUARDAR -->
        <!-- ========================================= -->

        <Style x:Key="GuardarButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="130"/>

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#2563EB"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>


        <!-- ========================================= -->
        <!-- BOTÓN CANCELAR -->
        <!-- ========================================= -->

        <Style x:Key="CancelarButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="130"/>

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#243B5A"/>

            <Setter Property="Background"
                    Value="#E5E7EB"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

    </Window.Resources>


    <!-- ================================================= -->
    <!-- CONTENEDOR PRINCIPAL -->
    <!-- ================================================= -->

    <Grid Margin="28">

        <Grid.RowDefinitions>

            <!-- Encabezado -->
            <RowDefinition Height="Auto"/>

            <!-- Formulario -->
            <RowDefinition Height="*"/>

            <!-- Botones -->
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- ================================================= -->
        <!-- ENCABEZADO -->
        <!-- ================================================= -->

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#DCE5F0"
                BorderThickness="1"
                CornerRadius="14"
                Padding="25"
                Margin="0,0,0,20">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="70"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- ICONO -->

                <Border Grid.Column="0"
                        Width="58"
                        Height="58"
                        CornerRadius="12"
                        Background="#2563EB"
                        HorizontalAlignment="Left">

                    <TextBlock Text="▤"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>


                <!-- TÍTULO -->

                <StackPanel Grid.Column="1"
                            Margin="18,0,0,0"
                            VerticalAlignment="Center">

                    <!-- NUEVO PEDIDO -->

                    <TextBlock Text="Nuevo pedido"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#1E3555">

                        <TextBlock.Style>

                            <Style TargetType="TextBlock">

                                <Setter Property="Visibility"
                                        Value="Visible"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding EsEdicion}"
                                                 Value="True">

                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </TextBlock.Style>

                    </TextBlock>


                    <!-- EDITAR PEDIDO -->

                    <TextBlock Text="Editar pedido"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#1E3555">

                        <TextBlock.Style>

                            <Style TargetType="TextBlock">

                                <Setter Property="Visibility"
                                        Value="Collapsed"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding EsEdicion}"
                                                 Value="True">

                                        <Setter Property="Visibility"
                                                Value="Visible"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </TextBlock.Style>

                    </TextBlock>


                    <TextBlock Text="Ingrese los datos del pedido"
                               FontSize="14"
                               Foreground="#718096"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ================================================= -->
        <!-- FORMULARIO -->
        <!-- ================================================= -->

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#DCE5F0"
                BorderThickness="1"
                CornerRadius="14"
                Padding="25">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- ================================================= -->
                    <!-- COLUMNA IZQUIERDA -->
                    <!-- ================================================= -->

                    <StackPanel Grid.Column="0"
                                Margin="0,0,15,0">


                        <!-- CLIENTE -->

                        <TextBlock Text="Cliente"
                                   Style="{StaticResource LabelStyle}"/>

                        <ComboBox ItemsSource="{Binding Clientes}"
                                  DisplayMemberPath="Empresa"
                                  SelectedValuePath="ClienteID"
                                  SelectedValue="{Binding Pedido.ClienteID,
                                                          Mode=TwoWay,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource ComboStyle}"/>


                        <!-- EMPLEADO -->

                        <TextBlock Text="Empleado"
                                   Style="{StaticResource LabelStyle}"/>

                        <ComboBox ItemsSource="{Binding Empleados}"
                                  DisplayMemberPath="NombreCompleto"
                                  SelectedValuePath="EmpleadoID"
                                  SelectedValue="{Binding Pedido.EmpleadoID,
                                                          Mode=TwoWay,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource ComboStyle}"/>


                        <!-- FECHA PEDIDO -->

                        <TextBlock Text="Fecha de pedido"
                                   Style="{StaticResource LabelStyle}"/>

                        <DatePicker SelectedDate="{Binding Pedido.FechaPedido,
                                                           Mode=TwoWay,
                                                           UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource DateStyle}"/>


                        <!-- FECHA REQUERIDA -->

                        <TextBlock Text="Fecha requerida"
                                   Style="{StaticResource LabelStyle}"/>

                        <DatePicker SelectedDate="{Binding Pedido.FechaRequerida,
                                                           Mode=TwoWay,
                                                           UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource DateStyle}"/>


                        <!-- FECHA ENVÍO -->

                        <TextBlock Text="Fecha de envío"
                                   Style="{StaticResource LabelStyle}"/>

                        <DatePicker SelectedDate="{Binding Pedido.FechaEnvio,
                                                           Mode=TwoWay,
                                                           UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource DateStyle}"/>

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- COLUMNA DERECHA -->
                    <!-- ================================================= -->

                    <StackPanel Grid.Column="1"
                                Margin="15,0,0,0">


                        <!-- TRANSPORTISTA -->

                        <TextBlock Text="Transportista"
                                   Style="{StaticResource LabelStyle}"/>

                        <ComboBox ItemsSource="{Binding Transportistas}"
                                  DisplayMemberPath="CompaniaNombre"
                                  SelectedValuePath="TransportistaID"
                                  SelectedValue="{Binding Pedido.TransportistaID,
                                                          Mode=TwoWay,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource ComboStyle}"/>


                        <!-- DESTINATARIO -->

                        <TextBlock Text="Destinatario"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding Pedido.Destinatario,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="60"
                                 Style="{StaticResource InputStyle}"/>


                        <!-- CIUDAD DESTINO -->

                        <TextBlock Text="Ciudad de destino"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding Pedido.CiudadDestino,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="30"
                                 Style="{StaticResource InputStyle}"/>


                        <!-- PAÍS DESTINO -->

                        <TextBlock Text="País de destino"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding Pedido.PaisDestino,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="30"
                                 Style="{StaticResource InputStyle}"/>


                        <!-- INFORMACIÓN -->

                        <Border Background="#F1F5F9"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,10">

                            <TextBlock Text="Cliente, empleado y transportista se seleccionan desde las listas disponibles. Las fechas requerida y de envío son opcionales."
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="#64748B"/>

                        </Border>

                    </StackPanel>

                </Grid>

            </ScrollViewer>

        </Border>


        <!-- ================================================= -->
        <!-- BOTONES -->
        <!-- ================================================= -->

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#DCE5F0"
                BorderThickness="1"
                CornerRadius="14"
                Padding="20"
                Margin="0,20,0,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Cancelar"
                        Style="{StaticResource CancelarButtonStyle}"
                        Click="Cancelar_Click"
                        Margin="0,0,12,0"/>

                <Button Content="Guardar"
                        Style="{StaticResource GuardarButtonStyle}"
                        Click="Guardar_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>